{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/same-event-stress-test/config.schema.json",
  "title": "SameEventStressTestConfig",
  "type": "object",
  "required": [
    "meta",
    "inputs",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "title",
        "company_label"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "company_label": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "inputs": {
      "type": "object",
      "required": [
        "revenue_y0",
        "revenue_growth",
        "opex_pct_of_revenue",
        "tax_rate",
        "da_pct_of_revenue",
        "capex_pct_of_revenue",
        "nwc_pct_of_delta_revenue",
        "royalty_rate",
        "commodity_price_index",
        "commodity_shock",
        "risk_free_rate",
        "equity_risk_premium",
        "beta",
        "pre_tax_cost_of_debt",
        "debt_weight",
        "equity_weight",
        "rate_shock_bp",
        "terminal_growth",
        "exit_ebitda_multiple",
        "gross_debt",
        "cash",
        "floating_debt_share",
        "fixed_debt_duration_years",
        "diluted_shares_million",
        "base_buyback_cash",
        "cost_elasticity",
        "capex_price_elasticity"
      ],
      "additionalProperties": false,
      "properties": {
        "revenue_y0": {
          "type": "number"
        },
        "revenue_growth": {
          "type": "number"
        },
        "opex_pct_of_revenue": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Operating expenses (excluding royalty) as % of revenue. INCLUDES depreciation and amortisation (D&A): EBIT = revenue \u2212 opex \u2212 royalty, and free cash flow to the firm (FCFF) adds D&A back."
        },
        "tax_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "da_pct_of_revenue": {
          "type": "number"
        },
        "capex_pct_of_revenue": {
          "type": "number"
        },
        "nwc_pct_of_delta_revenue": {
          "type": "number"
        },
        "royalty_rate": {
          "type": "number"
        },
        "commodity_price_index": {
          "type": "number"
        },
        "commodity_shock": {
          "type": "number"
        },
        "risk_free_rate": {
          "type": "number"
        },
        "equity_risk_premium": {
          "type": "number"
        },
        "beta": {
          "type": "number"
        },
        "pre_tax_cost_of_debt": {
          "type": "number"
        },
        "debt_weight": {
          "type": "number"
        },
        "equity_weight": {
          "type": "number"
        },
        "rate_shock_bp": {
          "type": "number"
        },
        "wacc_override": {
          "type": [
            "number",
            "null"
          ]
        },
        "terminal_growth": {
          "type": "number"
        },
        "exit_ebitda_multiple": {
          "type": "number"
        },
        "gross_debt": {
          "type": "number"
        },
        "cash": {
          "type": "number"
        },
        "floating_debt_share": {
          "type": "number"
        },
        "fixed_debt_duration_years": {
          "type": "number"
        },
        "diluted_shares_million": {
          "type": "number"
        },
        "base_buyback_cash": {
          "type": "number"
        },
        "cost_elasticity": {
          "type": "number"
        },
        "capex_price_elasticity": {
          "type": "number"
        },
        "covenant_nd_ebitda_limit": {
          "type": [
            "number",
            "null"
          ],
          "description": "Optional maximum net debt / Year-1 EBITDA (earnings before interest, tax, depreciation and amortisation) covenant. Blank/null = not applicable. Shown on every event sheet next to the mirror and on the Summary, outside FULL and the blend. EBITDA = EBIT + D&A, with EBIT = revenue \u2212 opex \u2212 royalty; opex already includes D&A."
        }
      }
    },
    "events": {
      "type": "object",
      "required": [
        "rates"
      ],
      "additionalProperties": false,
      "properties": {
        "rates": {
          "$ref": "#/$defs/eventSpec"
        },
        "commodity": {
          "$ref": "#/$defs/eventSpec"
        },
        "tariff": {
          "$ref": "#/$defs/eventSpec"
        },
        "capex": {
          "$ref": "#/$defs/capexEventSpec"
        },
        "fx": {
          "$ref": "#/$defs/fxEventSpec"
        },
        "demand": {
          "$ref": "#/$defs/demandEventSpec"
        }
      }
    },
    "tariff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "units": {
          "type": "number"
        },
        "price": {
          "type": "number"
        },
        "unit_cost": {
          "type": "number"
        },
        "fixed_cost": {
          "type": "number"
        },
        "cost_shock_pct": {
          "type": "number"
        },
        "pass_through_pct": {
          "type": "number"
        },
        "elasticity": {
          "type": "number"
        },
        "markdown_pct": {
          "type": "number"
        },
        "mitigation_pct": {
          "type": "number"
        }
      }
    },
    "passthrough": {
      "type": "object",
      "required": [
        "units",
        "price",
        "unit_cost",
        "fixed_cost",
        "pass_through_pct",
        "elasticity",
        "markdown_pct",
        "mitigation_pct"
      ],
      "additionalProperties": false,
      "properties": {
        "units": {
          "type": "number"
        },
        "price": {
          "type": "number"
        },
        "unit_cost": {
          "type": "number"
        },
        "fixed_cost": {
          "type": "number"
        },
        "cost_shock_pct": {
          "type": "number"
        },
        "pass_through_pct": {
          "type": "number"
        },
        "elasticity": {
          "type": "number"
        },
        "markdown_pct": {
          "type": "number"
        },
        "mitigation_pct": {
          "type": "number"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "live_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sheet",
              "cell",
              "new_value",
              "expect_move"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "sheet": {
                "type": "string"
              },
              "cell": {
                "type": "string"
              },
              "new_value": {},
              "expect_move": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "expect_unchanged": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "shock_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sheet",
              "cell",
              "new_value",
              "full_cell",
              "expected_direction"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "sheet": {
                "type": "string"
              },
              "cell": {
                "type": "string"
              },
              "new_value": {},
              "full_cell": {
                "type": "string"
              },
              "expected_direction": {
                "type": "string",
                "enum": [
                  "decrease",
                  "increase"
                ]
              },
              "expect_unchanged": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "channel_tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sheet",
              "cell",
              "new_value",
              "channel_cell",
              "full_cell",
              "expected_channel_direction",
              "expected_full_direction"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "sheet": {
                "type": "string"
              },
              "cell": {
                "type": "string"
              },
              "new_value": {},
              "channel_cell": {
                "type": "string"
              },
              "full_cell": {
                "type": "string"
              },
              "expected_channel_direction": {
                "type": "string",
                "enum": [
                  "decrease",
                  "increase"
                ]
              },
              "expected_full_direction": {
                "type": "string",
                "enum": [
                  "decrease",
                  "increase"
                ]
              },
              "covers_full": {
                "type": "boolean"
              }
            }
          }
        },
        "channel_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cell",
              "must_equal_formula"
            ],
            "additionalProperties": false,
            "properties": {
              "cell": {
                "type": "string"
              },
              "must_equal_formula": {
                "type": "string"
              },
              "adverse_vs_base": {
                "type": "boolean"
              },
              "base_cell": {
                "type": "string"
              }
            }
          }
        },
        "charts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tornado": {
              "type": "object",
              "required": [
                "value_ref",
                "cat_ref"
              ],
              "additionalProperties": false,
              "properties": {
                "value_ref": {
                  "type": "string"
                },
                "cat_ref": {
                  "type": "string"
                }
              }
            },
            "football": {
              "type": "object",
              "required": [
                "baseline_value_ref",
                "width_value_ref",
                "cat_ref"
              ],
              "additionalProperties": false,
              "properties": {
                "baseline_value_ref": {
                  "type": "string"
                },
                "width_value_ref": {
                  "type": "string"
                },
                "cat_ref": {
                  "type": "string"
                },
                "baseline_nofill": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "eventSpec": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "threshold_value_per_share": {
          "type": [
            "number",
            "null"
          ],
          "description": "Optional typed reverse-stress threshold in $/sh (blended-mid proxy). Overrides the default formula (base \u00d7 (1 \u2212 threshold_drop_pct)). Null/absent = use the default formula."
        },
        "calibration_source": {
          "type": "string",
          "description": "Source and date of the shock size. Default 'TO FILL: source'. Never invent a statistic."
        },
        "calibration_basis": {
          "type": "string",
          "description": "Basis of the shock size, e.g. historical 1-year 95th percentile move. Default 'TO FILL: basis'."
        },
        "reverse_stress_multiples": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "8 ascending multiples of the configured shock for the reverse stress grid."
        },
        "threshold_drop_pct": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Drop below base value per share that defines the default reverse-stress threshold (yellow input). Absent = 0.25 (25%); null = blank \u2192 reverse-stress result n/a."
        },
        "calibration_severity": {
          "type": "string",
          "description": "Severity label: plausible, severe or extreme (or TO FILL: severity). Default 'TO FILL: severity'."
        }
      }
    },
    "capexEventSpec": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "threshold_value_per_share": {
          "type": [
            "number",
            "null"
          ],
          "description": "Optional typed reverse-stress threshold in $/sh (blended-mid proxy). Overrides the default formula (base \u00d7 (1 \u2212 threshold_drop_pct)). Null/absent = use the default formula."
        },
        "calibration_source": {
          "type": "string",
          "description": "Source and date of the shock size. Default 'TO FILL: source'. Never invent a statistic."
        },
        "calibration_basis": {
          "type": "string",
          "description": "Basis of the shock size, e.g. historical 1-year 95th percentile move. Default 'TO FILL: basis'."
        },
        "reverse_stress_multiples": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "8 ascending multiples of the configured shock for the reverse stress grid."
        },
        "customer_capex_shock_pct": {
          "type": "number",
          "description": "Customer capex shock (enter the adverse direction)."
        },
        "revenue_elasticity_to_customer_capex": {
          "type": "number"
        },
        "own_capex_response": {
          "type": "number"
        },
        "equity_funding_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "issue_price_per_share": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "threshold_drop_pct": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Drop below base value per share that defines the default reverse-stress threshold (yellow input). Absent = 0.25 (25%); null = blank \u2192 reverse-stress result n/a."
        },
        "calibration_severity": {
          "type": "string",
          "description": "Severity label: plausible, severe or extreme (or TO FILL: severity). Default 'TO FILL: severity'."
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "customer_capex_shock_pct",
          "revenue_elasticity_to_customer_capex",
          "own_capex_response",
          "equity_funding_share",
          "issue_price_per_share",
          "label"
        ]
      }
    },
    "fxEventSpec": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "threshold_value_per_share": {
          "type": [
            "number",
            "null"
          ],
          "description": "Optional typed reverse-stress threshold in $/sh (blended-mid proxy). Overrides the default formula (base \u00d7 (1 \u2212 threshold_drop_pct)). Null/absent = use the default formula."
        },
        "calibration_source": {
          "type": "string",
          "description": "Source and date of the shock size. Default 'TO FILL: source'. Never invent a statistic."
        },
        "calibration_basis": {
          "type": "string",
          "description": "Basis of the shock size, e.g. historical 1-year 95th percentile move. Default 'TO FILL: basis'."
        },
        "calibration_severity": {
          "type": "string",
          "description": "Severity label: plausible, severe or extreme (or TO FILL: severity). Default 'TO FILL: severity'."
        },
        "reverse_stress_multiples": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "8 ascending multiples of the configured shock for the reverse stress grid."
        },
        "threshold_drop_pct": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Drop below base value per share that defines the default reverse-stress threshold (yellow input). Absent = 0.25 (25%); null = blank \u2192 reverse-stress result n/a."
        },
        "fx_shock_pct": {
          "type": "number",
          "description": "Home-currency appreciation (enter the adverse direction; a positive value means the home currency strengthens)."
        },
        "foreign_revenue_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of revenue earned in foreign currency."
        },
        "foreign_cost_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of operating costs denominated in foreign currency (natural hedge)."
        },
        "fx_debt_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of gross debt denominated in foreign currency (remeasured in the net-debt bridge)."
        },
        "hedge_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of foreign-currency revenue covered by financial hedges (forwards). Counted once, with the natural cost offset."
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "fx_shock_pct",
          "foreign_revenue_share",
          "foreign_cost_share",
          "fx_debt_share",
          "hedge_ratio",
          "label"
        ]
      }
    },
    "demandEventSpec": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "threshold_value_per_share": {
          "type": [
            "number",
            "null"
          ],
          "description": "Optional typed reverse-stress threshold in $/sh (blended-mid proxy). Overrides the default formula (base \u00d7 (1 \u2212 threshold_drop_pct)). Null/absent = use the default formula."
        },
        "calibration_source": {
          "type": "string",
          "description": "Source and date of the shock size. Default 'TO FILL: source'. Never invent a statistic."
        },
        "calibration_basis": {
          "type": "string",
          "description": "Basis of the shock size, e.g. historical 1-year 95th percentile move. Default 'TO FILL: basis'."
        },
        "calibration_severity": {
          "type": "string",
          "description": "Severity label: plausible, severe or extreme (or TO FILL: severity). Default 'TO FILL: severity'."
        },
        "reverse_stress_multiples": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": "8 ascending multiples of the configured shock for the reverse stress grid."
        },
        "threshold_drop_pct": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1,
          "description": "Drop below base value per share that defines the default reverse-stress threshold (yellow input). Absent = 0.25 (25%); null = blank \u2192 reverse-stress result n/a."
        },
        "volume_shock_pct": {
          "type": "number",
          "description": "Demand / volume shock (enter the adverse direction, typically negative)."
        },
        "price_mix_elasticity": {
          "type": "number",
          "description": "Price/mix % change per 1.0 volume % change. Positive means price/mix moves with volume (a volume fall also weakens mix)."
        },
        "fixed_cost_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of opex (operating expenses, including D&A) that does not move with volume."
        },
        "inventory_to_sales": {
          "type": "number",
          "minimum": 0,
          "description": "Inventory-to-sales ratio used for the Year-1 downside-only inventory cash use (volume fall only)."
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "volume_shock_pct",
          "price_mix_elasticity",
          "fixed_cost_share",
          "inventory_to_sales",
          "label"
        ]
      }
    }
  }
}
